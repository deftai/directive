{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host grok --event session.start",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|WriteFile|CreateFile|MultiEdit|NotebookEdit|EditNotebook|edit_notebook|StrReplace|SearchReplace|Delete|DeleteFile|ApplyPatch|apply_patch|write|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "./deft-pretooluse-wrapper.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Task|SubagentStart|spawn_subagent|start_agent|CreateAgent",
        "hooks": [
          {
            "type": "command",
            "command": "./deft-pretooluse-wrapper.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Shell|Bash|BashTool|shell|bash|run_terminal_command|monitor",
        "hooks": [
          {
            "type": "command",
            "command": "./deft-pretooluse-wrapper.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "kill_command_or_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "./deft-pretooluse-wrapper.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*|mcp_.*|.*__.*|CallMcpTool|use_tool|merge_pull_request|merge-pull-request|pull_request_merge|pull-request-merge|merge_pr|pr_merge|pr-merge|git_push|git-push|push_branch|push-branch|.*merge[_-]?pull[_-]?request.*|.*pull[_-]?request[_-]?merge.*|.*(?:^|[_-])merge_pr(?:$|[_-]).*|.*pr[_-]?merge.*|.*git[_-]?push.*|.*push[_-]?branch.*|.*push.*(?:git|branch|remote|ref).*|.*(?:git|branch|remote|ref).*push.*",
        "hooks": [
          {
            "type": "command",
            "command": "./deft-pretooluse-wrapper.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host grok --event session.compact",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host grok --event session.compact",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
