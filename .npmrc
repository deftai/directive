# Do not let pnpm refuse to run when the corepack-provided binary version differs
# from the `packageManager` pin in package.json (#1922). On GitHub-hosted
# windows-latest, corepack resolves a newer patch (e.g. 11.9.0) than the pinned
# 11.8.0 when pnpm is invoked from a directory without its own pin (the consumer
# fixture in the Windows task-dispatch regression job), and pnpm's default
# self-management hard-fails ("pnpm does not switch versions when running under
# corepack"). Disabling self-management lets the corepack binary run against the
# pinned project without a patch-drift hard failure; corepack still supplies the
# binary, and the lockfile is compatible across pnpm 11.x patches.
manage-package-manager-versions=false
