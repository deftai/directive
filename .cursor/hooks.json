{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host cursor --event session.start",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host cursor --event tool.before",
        "matcher": "Edit|Write|WriteFile|CreateFile|MultiEdit|NotebookEdit|EditNotebook|edit_notebook|StrReplace|SearchReplace|Delete|DeleteFile|ApplyPatch|apply_patch|write|search_replace",
        "failClosed": true,
        "timeout": 30
      },
      {
        "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host cursor --event tool.before",
        "matcher": "Task|SubagentStart|spawn_subagent|start_agent|CreateAgent",
        "failClosed": true,
        "timeout": 30
      },
      {
        "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host cursor --event tool.before",
        "matcher": "Shell|Bash|BashTool|shell|bash|run_terminal_command|monitor",
        "failClosed": true,
        "timeout": 30
      },
      {
        "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host cursor --event tool.before",
        "matcher": "kill_command_or_subagent",
        "failClosed": true,
        "timeout": 30
      },
      {
        "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host cursor --event tool.before",
        "matcher": "mcp__.*|mcp_.*|.*__.*|CallMcpTool|use_tool|merge_pull_request|merge-pull-request|pull_request_merge|pull-request-merge|merge_pr|pr_merge|pr-merge|git_push|git-push|push_branch|push-branch|.*merge[_-]?pull[_-]?request.*|.*pull[_-]?request[_-]?merge.*|.*(?:^|[_-])merge_pr(?:$|[_-]).*|.*pr[_-]?merge.*|.*git[_-]?push.*|.*push[_-]?branch.*|.*push.*(?:git|branch|remote|ref).*|.*(?:git|branch|remote|ref).*push.*",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "preCompact": [
      {
        "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host cursor --event session.compact",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host cursor --event prompt.submit",
        "timeout": 5
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node node_modules/@deftai/directive-runtime/dist/hook-bin.js --host cursor --event agent.response",
        "timeout": 5
      }
    ]
  }
}
