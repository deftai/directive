# Pre-cutover backups written by `task migrate:vbrief` (#497, #506 D7).
# Operators who want these versioned can delete these lines or override per-file.
*.premigrate.*
vbrief/*.premigrate.*
xbrief/*.premigrate.*

# Migration backups (created by `task migrate:vbrief`) -- do NOT commit.
# Post-commit, pre-migration state is recoverable via git history; see
# deft/main.md § Safety flags for the post-commit recovery path.
*.premigrate.md
*.premigrate.vbrief.json
*.premigrate.xbrief.json

# Local triage / refinement issue cache (#845 Story 1). Sidecar mirror of
# `gh issue list` populated by `task triage:cache`; never versioned. See
# scripts/triage_cache.py for the layout (.deft-cache/issues/<owner>-<repo>/).
.deft-cache/

# vbrief/.triage-cache/ tracking governance (#1144, N4 of #1119).
# Hybrid policy from the Current Shape comment on #1144:
#   - candidates.jsonl       -> gitignored (operator-private triage decisions;
#                               re-derive via `task triage:bootstrap` on a
#                               fresh clone). #845 Story 2 + #915.
#   - summary-history.jsonl  -> gitignored (operator-private observability;
#                               not load-bearing for any decision).
#   - scope-lifecycle.jsonl  -> gitignored (operator-private scope-lifecycle
#                               audit decisions; D1 / #1121). Per-operator
#                               demote stream; sharing would conflate
#                               operators' demote timing across the team.
#   - decompositions/        -> gitignored (temporary decomposition proposal
#                               drafts; generated child story vBRIEFs live in
#                               lifecycle folders via task scope:decompose).
#   - slices.jsonl           -> TRACKED (team-shared cohort records produced
#                               by slicing skills; see #1132 / D13).
#   - doctor-state.json      -> gitignored (operator-private doctor throttle
#                               state; persisted by `run doctor` /
#                               `task doctor` per #1308 to gate the 24h/4h
#                               re-probe window. Local to each clone; never
#                               committed).
# See xbrief/.triage-cache/README.md for the full policy + merge=union rebase note.
# Canonical xbrief/ layout (#2109) -- same governance as the legacy vbrief/ block below.
xbrief/.triage-cache/candidates.jsonl
xbrief/.triage-cache/summary-history.jsonl
xbrief/.triage-cache/scope-lifecycle.jsonl
xbrief/.triage-cache/decompositions/
xbrief/.triage-cache/doctor-state.json
xbrief/.triage-cache/staleness-tickler-state.json
xbrief/.triage-cache/release-availability-state.json
xbrief/.triage-cache/*.lock
# Legacy vbrief/ layout (back-compat read window; removed by #2112).
vbrief/.triage-cache/candidates.jsonl
vbrief/.triage-cache/summary-history.jsonl
vbrief/.triage-cache/scope-lifecycle.jsonl
vbrief/.triage-cache/decompositions/
vbrief/.triage-cache/doctor-state.json
vbrief/.triage-cache/staleness-tickler-state.json
vbrief/.triage-cache/release-availability-state.json
vbrief/.triage-cache/*.lock

# .eval/ namespace (#1703 Tier 2). `.eval/results/` holds team-shared, TRACKED
# version-eval records (health-history.jsonl, golden-runs.jsonl). The loose
# operator-private basenames below are legacy triage-cache stragglers that
# `triage/cache-path.ts` migrates into `.triage-cache/`; ignore them in place so
# they can never be re-committed to `.eval/`, and never blanket-ignore `.eval/`
# itself (that would drop the tracked results/ ledger; #1464). Scratch `_tmp_*`
# issue-body dumps are runtime artefacts, never versioned.
xbrief/.eval/candidates.jsonl
xbrief/.eval/summary-history.jsonl
xbrief/.eval/scope-lifecycle.jsonl
xbrief/.eval/decompositions/
xbrief/.eval/doctor-state.json
xbrief/.eval/*.lock
xbrief/.eval/_tmp_*
vbrief/.eval/candidates.jsonl
vbrief/.eval/summary-history.jsonl
vbrief/.eval/scope-lifecycle.jsonl
vbrief/.eval/decompositions/
vbrief/.eval/doctor-state.json
vbrief/.eval/*.lock
vbrief/.eval/_tmp_*

# N6 (#1146) triage:smoketest assert log -- runtime artefact, never committed.
# The fixture itself (tests/fixtures/triage_smoketest/{issues.json,
# PROJECT-DEFINITION.vbrief.json, vbrief/, README.md}) IS committed; only the
# per-run last_run.json output is gitignored.
tests/fixtures/triage_smoketest/last_run.json

# Monitor scratch (poller scripts, banner-edit helpers, etc.)
.swarm/

# Scratch automation + issue/PR bodies in history/ (WD AI guideline: "prior tasks -> history/").
# These accumulate as one-off helpers per session; never versioned.
history/_*
history/issue-*
history/*.json
history/post-issue.py

# One-off operator scripts left at root from prior sessions -- move to history/ or delete.
poll-fetch.ps1
vbrief/PROJECT-DEFINITION.vbrief.json.lock
xbrief/PROJECT-DEFINITION.xbrief.json.lock

# Generated codebase MAP projection (#1932) -- a per-project, code-derived
# artifact (filesystem-walk fileCount/contentHash) that churns on any source
# change. Tracking it forced every concurrent branch to regenerate + commit it,
# guaranteeing mechanical merge conflicts across cohorts. The durable source of
# truth is plan.architecture.codeStructure (validated by codebase:validate-structure);
# regenerate the projection on demand with `task codebase:map`.
.planning/codebase/MAP.md

# Per-session scratch root files left by orchestrator/swarm handoffs --
# move to history/ or delete; never committed.
.deft-scratch/
docs/incidents/
handoff-*.md
epic_full_body.md
swarm_grok_issue.md

# Generated interactive Rule Map (build with `task docs:rule-map`); RULE-MAP.md is committed.
docs/rule-map/

# Local task / agent operator scratch logs (reconcile, release dry-runs, cohort notes).
# Not source of truth; re-creatable. Keep out of version control.
.task/

# #3282 run-summary default path
.deft-run-summary.json

xbrief/.triage-cache/scm-label-mirror-discovery-state.json

# Agent-host working state (#3502). Selective only -- .claude/settings.json,
# .claude/skills/ and .claude/commands/ are managed Directive deposits and
# must stay trackable. This repo is not a consumer deposit, so it does not
# inherit CANONICAL_GITIGNORE_BASELINE reconciliation.
.claude/worktrees/
.claude/settings.local.json
