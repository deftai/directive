{
  "name": "deft-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "TypeScript engine monorepo for the deft directive framework (Wave-1 scaffold, #1717).",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && node ./packages/cli/scripts/bundle.mjs",
    "clean": "tsc -b --clean",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify:license-sync": "node ./scripts/verify-license-sync.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@deftai/directive-runtime": "0.129.2",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "esbuild": "^0.28.1",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4"
  }
}
