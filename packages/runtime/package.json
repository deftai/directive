{
  "name": "@deftai/directive-runtime",
  "version": "0.0.0",
  "description": "Directive project runtime (the exact version pinned in your project). The directive and deft commands come from the global @deftai/directive launcher; this package has no such commands on purpose.",
  "license": "MIT",
  "homepage": "https://github.com/deftai/directive#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "directive-runtime": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deftai/directive.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "directive": {
    "contract": 1
  },
  "dependencies": {
    "@deftai/directive-core": "workspace:*",
    "@deftai/directive-content": "workspace:*",
    "@deftai/directive-types": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b"
  }
}
