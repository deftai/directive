{
  "name": "@deftai/directive",
  "version": "0.0.0",
  "description": "Directive CLI — npm install path for the Deft Directive framework.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "directive": "./dist/bin.js",
    "deft": "./dist/bin.js",
    "deft-ts": "./dist/bin.js",
    "deft-hook": "./dist/hook-bin.js",
    "deft-verify-encoding": "./dist/verify-encoding.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deftai/directive.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@deftai/directive-core": "workspace:*",
    "@deftai/directive-content": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b"
  }
}
