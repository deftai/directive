{
  "name": "@deftai/directive-types",
  "version": "0.0.0",
  "description": "Shared TypeScript types for the Directive framework engine.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/vbrief-core-0.6.schema.json": "./schemas/vbrief-core-0.6.schema.json",
    "./schemas/xbrief-core-0.8.schema.json": "./schemas/xbrief-core-0.8.schema.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "schemas/**/*.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deftai/directive.git",
    "directory": "packages/types"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "node ./scripts/sync-schema.mjs",
    "build": "tsc -b"
  }
}
